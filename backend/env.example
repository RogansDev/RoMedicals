# Configuración de Base de Datos
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_password_mysql
DB_NAME=romedicals_main

# Configuración del Servidor
PORT=3001
NODE_ENV=development

# Configuración JWT
JWT_SECRET=romedicals_super_secret_key_2024_change_in_production

# Configuración Frontend
FRONTEND_URL=http://localhost:3000

# Configuración de Email (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_password_app

# Configuración de Archivos
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Configuración de Seguridad
BCRYPT_ROUNDS=12
JWT_EXPIRES_IN=24h
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Configuración de DeepSeek API (para procesamiento de transcripciones médicas)
DEEPSEEK_API_KEY=tu_deepseek_api_key_aqui

# Configuración de VideoSDK
VIDEOSDK_API_KEY=tu_videosdk_api_key_aqui
VIDEOSDK_SECRET_KEY=tu_videosdk_secret_key_aqui